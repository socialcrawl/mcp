{
  "name": "socialcrawl-mcp",
  "version": "1.8.0",
  "description": "MCP server for SocialCrawl — access 44 platforms and 357 endpoints (social media, commerce & product reviews, app stores, places & travel, business reputation, web research, full web scraping & browser automation, prediction markets, search trends, Naver, content analysis, Google News/Finance/Trends, cross-platform Prism composites, universal meta-search) through one unified API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "socialcrawl-mcp": "dist/index.js",
    "socialcrawl-mcp-http": "dist/http.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:http": "tsx watch src/http.ts",
    "clean": "rm -rf dist",
    "generate:data": "tsx scripts/generate-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "social-media",
    "api",
    "ai-agents",
    "socialcrawl",
    "tiktok",
    "instagram",
    "youtube",
    "twitter",
    "linkedin",
    "reddit",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RidioDevelopment/socialcrawl-mcp"
  },
  "mcpName": "io.github.RidioDevelopment/socialcrawl",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
